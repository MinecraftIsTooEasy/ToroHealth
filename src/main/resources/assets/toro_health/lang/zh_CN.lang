config.menu.name.toro_health=ToroHealth 血量显示
config.menu.comment.toro_health=显示准星目标实体的生命值与伤害数字。
config.tab.generic=显示

config.name.toro_health.show_entity_model=显示实体模型
config.comment.toro_health.show_entity_model=显示准星目标实体的3D预览模型。
config.name.toro_health.show_damage_particles=显示伤害数字
config.comment.toro_health.show_damage_particles=显示目标实体受到的伤害和治疗数值。
config.name.toro_health.entity_status_display=血量显示样式
config.comment.toro_health.entity_status_display=选择实体血量的显示方式。
config.enum.toro_health.entity_status_display.HEARTS=心形
config.enum.toro_health.entity_status_display.NUMERIC=数字
config.enum.toro_health.entity_status_display.BAR=血条
config.enum.toro_health.entity_status_display.OFF=关闭
config.name.toro_health.status_display_position=面板位置
config.comment.toro_health.status_display_position=选择状态面板在屏幕上的位置。
config.enum.toro_health.status_display_position.TOP_LEFT=左上
config.enum.toro_health.status_display_position.TOP_CENTER=上方居中
config.enum.toro_health.status_display_position.TOP_RIGHT=右上
config.enum.toro_health.status_display_position.BOTTOM_LEFT=左下
config.enum.toro_health.status_display_position.BOTTOM_RIGHT=右下
config.enum.toro_health.status_display_position.CUSTOM=自定义
config.name.toro_health.skin=面板皮肤
config.comment.toro_health.skin=选择状态面板的外观。
config.enum.toro_health.skin.NONE=无
config.enum.toro_health.skin.BASIC=简洁
config.enum.toro_health.skin.HEAVY=厚重
config.name.toro_health.status_display_x=水平偏移
config.comment.toro_health.status_display_x=调整面板的水平位置，范围为 -200 到 200 像素。
config.name.toro_health.status_display_y=垂直偏移
config.comment.toro_health.status_display_y=调整面板的垂直位置，范围为 -200 到 200 像素。
config.name.toro_health.status_display_scale=信息框大小
config.comment.toro_health.status_display_scale=调整信息框的缩放比例，范围为 50% 到 200%。
config.name.toro_health.hide_delay=隐藏延迟
config.comment.toro_health.hide_delay=准星移开目标后，面板隐藏前等待的时间（毫秒）。
config.name.toro_health.damage_color=伤害数字颜色
config.comment.toro_health.damage_color=设置伤害数字的颜色。
config.name.toro_health.heal_color=治疗数字颜色
config.comment.toro_health.heal_color=设置治疗数字的颜色。
